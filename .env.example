# Loopback defaults. Do not commit real room tokens.
SYNCSPACE_HOST=127.0.0.1
SYNCSPACE_SYNC_PORT=4357
SYNCSPACE_WEB_PORT=5177
SYNCSPACE_DATA_DIR=./data
# Generated at runtime. Never commit a live value.
# SYNCSPACE_SAMPLE_TOKEN=
# Hosted trusted group (ADR-S08). Required when SYNCSPACE_HOST is not loopback.
# SYNCSPACE_ALLOWED_ORIGINS=https://your-app.vercel.app
# Leave unset on a public box. They mint an editor token for anyone who can hit the URL.
# SYNCSPACE_ENABLE_SAMPLE_ROOM=
# SYNCSPACE_ENABLE_DEV_SNAPSHOT=
# Public website. Leave unset so a Vercel build does not use loopback.
# When a sync host exists, set wss: / https: at website build time.
# VITE_SYNC_WS=
# VITE_SYNC_HTTP=
